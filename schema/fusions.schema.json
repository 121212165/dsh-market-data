{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/121212165/dsh-market-data/schema/fusions.schema.json",
  "title": "F3 fusion events snapshot (F8 consumes its sourcePluginIds)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "events"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "note": { "type": "string" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourcePluginIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "sourcePluginIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^dsh-plugin-[a-z0-9-]+$" },
            "minItems": 2
          },
          "license": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    }
  }
}
