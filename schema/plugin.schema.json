{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "repo",
    "name",
    "entries"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repo": {
      "type": "string"
    },
    "npm": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "oneLiner": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dshRange": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "verifiedAt": {
      "type": "string"
    }
  }
}
